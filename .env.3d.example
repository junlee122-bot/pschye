HITEM3D_CLIENT_ID=
HITEM3D_CLIENT_SECRET=

# Direct paid Hi3D tasks can use this provider-specific gate.
HITEM3D_ALLOW_SPEND=false

# Optional verified cloud fallback.
MESHY_API_KEY=
TRIPO_API_KEY=

# No cloud provider can spend credits unless this global gate is true
# and the command also includes --execute.
RAONJENA_3D_ALLOW_SPEND=false

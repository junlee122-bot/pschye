    "models:hero:production": ".tools\\blender\\blender-4.5.12-windows-x64\\blender.exe --background --python tools\\3d\\blender\\build_hero_production.py -- --input public\\models\\characters\\raon\\raon-triposr-v1.glb --output public\\models\\characters\\raon\\raon-production-v2.glb --blend artifacts\\3d\\blender\\raon-production-v2.blend --report artifacts\\3d\\blender\\raon-production-v2.json --texture-dir artifacts\\3d\\textures\\raon\\v2 --target-faces 28000 --texture-size 2048",
    "models:hero:retopo-probe": ".tools\\blender\\blender-4.5.12-windows-x64\\blender.exe --background --python tools\\3d\\blender\\retopology_probe.py -- --input public\\models\\characters\\raon\\raon-triposr-v1.glb --output artifacts\\3d\\blender\\raon-retopology-probe.json",

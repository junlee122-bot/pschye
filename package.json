    "models:meshy:generate": "node tools/3d/meshy-client.mjs generate",
    "models:providers:status": "node tools/3d/provider-router.mjs status",
    "models:providers:plan": "node tools/3d/provider-router.mjs plan",
    "models:providers:generate": "node tools/3d/provider-router.mjs generate",

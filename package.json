    "models:capture": "node tools/3d/capture-model-review.mjs \"http://127.0.0.1:4318/?section=archive&archive=models\"",
    "models:capture:mobile": "set REVIEW_WIDTH=390&& set REVIEW_HEIGHT=844&& set REVIEW_MOBILE=true&& node tools/3d/capture-model-review.mjs \"http://127.0.0.1:4318/?section=archive&archive=models\" docs/screenshots/3d-review-mobile.jpg",

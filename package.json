    "models:hero:inspect": ".tools\\blender\\blender-4.5.12-windows-x64\\blender.exe --background --python tools\\3d\\blender\\inspect_character.py -- --input public\\models\\characters\\raon\\raon-blender-rigged-v1.glb --output artifacts\\3d\\blender\\raon-runtime-inspection.json",

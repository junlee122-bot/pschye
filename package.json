    "models:hero:production-render": ".tools\\blender\\blender-4.5.12-windows-x64\\blender.exe artifacts\\3d\\blender\\raon-production-v2.blend --background --python tools\\3d\\blender\\render_hero_preview.py -- --output artifacts\\3d\\blender\\raon-production-idle-v2.png --action idle --frame 30",
    "models:hero:expression-render": ".tools\\blender\\blender-4.5.12-windows-x64\\blender.exe artifacts\\3d\\blender\\raon-production-v2.blend --background --python tools\\3d\\blender\\render_hero_preview.py -- --output artifacts\\3d\\blender\\raon-production-smile-v2.png --action talkNeutral --frame 24 --expression Mouth_Smile_Left --expression-weight 1",
    "models:hero:expressions-augment": ".tools\\blender\\blender-4.5.12-windows-x64\\blender.exe artifacts\\3d\\blender\\raon-production-v2.blend --background --python tools\\3d\\blender\\augment_hero_expressions.py -- --output public\\models\\characters\\raon\\raon-production-v2.glb --report artifacts\\3d\\blender\\raon-production-v2.json",

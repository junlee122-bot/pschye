    "models:triposr:batch": "node tools/3d/triposr-batch-generate.mjs",
    "models:triposr:local": "artifacts\\3d\\triposr-runtime\\.venv\\Scripts\\python.exe tools\\3d\\triposr-local-generate.py --source-root .tmp\\TripoSR-official --input artifacts\\3d\\hitem3d-inputs\\raon\\front.jpg --output public\\models\\characters\\raon\\raon-triposr-v1.glb --artifact-dir artifacts\\3d\\triposr\\raon --resolution 256 --chunk-size 2048",
    "models:triposr:canonicalize": "artifacts\\3d\\triposr-runtime\\.venv\\Scripts\\python.exe tools\\3d\\triposr-local-generate.py --source-root .tmp\\TripoSR-official --input artifacts\\3d\\hitem3d-inputs\\raon\\front.jpg --output public\\models\\characters\\raon\\raon-triposr-v1.glb --artifact-dir artifacts\\3d\\triposr\\raon --target-height 1.78 --postprocess-only",
